# Default values (used as fallback/local)
# Do not put secrets in these files.

BASE_URL=https://api.example.com
LOG_LEVEL=info

# Feature flags (prefix FEATURE_)
FEATURE_X_ENABLED=false
FEATURE_NEW_DASHBOARD=false

# Example of other config keys you might add later
# SENTRY_DSN=
# APP_THEME=system

# Security options (do not put secrets here)
# Enforce HTTPS at request layer (recommended true)
FORCE_HTTPS=true
# Enable TLS pinning via assets/certs (default false until you add certs)
TLS_PINNING_ENABLED=false
# Comma-separated list of cert asset paths (PEM/DER)
TLS_PIN_ASSETS=
