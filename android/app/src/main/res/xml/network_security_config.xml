<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: disallow cleartext; trust only system CAs by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Example domain pinning (replace with your API host and pins) -->
