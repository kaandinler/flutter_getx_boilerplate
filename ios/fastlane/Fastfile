default_platform(:ios)

platform :ios do
  before_all do
    api_key = app_store_connect_api_key(
      key_id: ENV['APP_STORE_CONNECT_API_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY'],
      is_key_content_base64: false,
      in_house: false
    )
    app_store_connect_api_key(api_key)
  end

  desc "Upload to TestFlight (build with Xcode)"
  lane :beta do
    build_app(scheme: "Runner", export_method: "app-store")
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Upload an existing IPA produced by Flutter"
  lane :beta_ipa do |options|
    ipa_path = options[:ipa] || "build/ios/ipa/*.ipa"
    groups = (ENV['TESTFLIGHT_GROUPS'] || '').split(',').map(&:strip).reject(&:empty?)
    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: false,
      distribute_external: groups.any?,
      groups: groups
    )
  end

  desc "Submit app for App Store review using existing IPA"
  lane :appstore_submit do |options|
    ipa_path = options[:ipa] || "build/ios/ipa/*.ipa"
    submit = (ENV['IOS_SUBMIT_FOR_REVIEW'] || 'false').downcase == 'true'
    auto_release = (ENV['IOS_AUTOMATIC_RELEASE'] || 'false').downcase == 'true'
    UI.message("Submit for review: #{submit}, Automatic release: #{auto_release}")
    deliver(
      ipa: ipa_path,
      submit_for_review: submit,
      automatic_release: auto_release,
      skip_screenshots: true,
      skip_metadata: true,
      force: true
    )
  end

  desc "Submit to App Store (manual submission)"
  lane :release do
    build_app(scheme: "Runner", export_method: "app-store")
    upload_to_app_store(submit_for_review: false)
  end
end
